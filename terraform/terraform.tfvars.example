# Copy to terraform.tfvars and replace the two required values. Try it in a test project first:
# the sink starts sending every log of the project to Pub/Sub as soon as it is applied.
gcp_project_id        = "my-project"
clickhouse_service_id = "00000000-0000-0000-0000-000000000000"

# Optional
# sink_exclusions          = [{ name = "k8s-lease-updates", filter = "protoPayload.methodName=\"io.k8s.coordination.v1.leases.update\"" }]
# topic_storage_regions    = ["asia-northeast1"]
# service_account_key_file = "clickpipes-key.json"
# clickstack_connection_id = "<connection id from ClickStack Team Settings>"
