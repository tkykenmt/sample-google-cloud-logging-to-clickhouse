# Copy to cli/.env (ignored by git) and fill in, or export the same variables.
GCP_PROJECT_ID=my-project
CH_SERVICE_ID=00000000-0000-0000-0000-000000000000

# Optional (defaults match terraform/variables.tf)
# TOPIC=gcl-to-clickhouse
# SINK=gcl-to-clickhouse
# SINK_FILTER='logName:"projects/my-project/logs/"'
# SA_ID=clickpipes-gcl
# ROLE_ID=clickpipesPubsubIngestion
# KEY_FILE=clickpipes-key.json        # existing key; created here when the file does not exist
# PIPE_NAME=gcl-v1
# SEEK_TYPE=latest
# LANDING_TTL_DAYS=7
# LOGS_TTL_DAYS=400
# MV_DEFINER=default
# TOPIC_STORAGE_REGIONS=asia-northeast1   # comma-separated; empty = not restricted
